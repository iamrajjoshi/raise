{
  "name": "raise",
  "version": "0.2.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "A self-hosted context and review channel for people and coding agents.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @raise/protocol build && pnpm --parallel --filter @raise/server --filter @raise/web dev",
    "build": "pnpm --filter @raise/protocol build && pnpm --filter @raise/web build && pnpm --filter @raise/server build && pnpm --filter @raise/mcp build",
    "start": "pnpm --filter @raise/server start",
    "mcp": "pnpm --filter @raise/mcp start",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && RAISE_MCP_ENTRY=apps/mcp/dist/main.js pnpm test",
    "readiness": "agent-readiness . --no-web",
    "readiness:json": "agent-readiness . --ci --no-web --format json",
    "readiness:check": "agent-readiness . --ci --no-web --min-level 2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kodus/agent-readiness": "0.1.3",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
