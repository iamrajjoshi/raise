PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATA_DIR=./data
# Required by the server. Both redis:// and rediss:// URLs are accepted.
VALKEY_URL=redis://127.0.0.1:6379
# local writes application-encrypted objects under DATA_DIR. s3 works with
# Cloudflare R2, AWS S3, MinIO, and other S3-compatible private buckets.
BLOB_STORE=local
# BLOB_S3_BUCKET=raise-blobs
# BLOB_S3_REGION=auto
# BLOB_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# BLOB_S3_FORCE_PATH_STYLE=false
# BLOB_S3_ACCESS_KEY_ID=
# BLOB_S3_SECRET_ACCESS_KEY=
# BLOB_S3_SESSION_TOKEN=
# The BLOB_S3_* credentials above are convenient for Docker Compose and other
# S3-compatible providers. Leave them unset to use an instance role or the AWS
# SDK's standard credential provider chain.
MAX_IMAGE_BYTES=15728640
